#!/bin/sh
# Starts a tool of tools/ on JDK 25, from the root of the repository, and says what is missing when there is none.
#
#   tools/run TOOL [ARGUMENTS...]       for example: tools/run Smoke http://localhost:8080
#
# It runs the java of JAVA_HOME when that is set, and else the one on the PATH. A tool is a compact source file, which a JDK
# older than 25 refuses with a message about a preview feature, so the version is checked here and said in words. The Gradle
# tasks (./gradlew tasks --group tooling) start the tools on the toolchain's JDK 25 whatever is on the PATH.
set -eu

tool=${1:?usage: tools/run TOOL [ARGUMENTS...]}
shift
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/.." && pwd)
[ -f "$here/$tool.java" ] || {
  echo "tools/run: there is no tool $tool in tools/" >&2
  exit 2
}

java=java
[ -z "${JAVA_HOME:-}" ] || java=$JAVA_HOME/bin/java
command -v "$java" >/dev/null 2>&1 || {
  echo "$tool: needs java 25, and found none (see JAVA_HOME and the PATH), or run the Gradle task of it" >&2
  exit 1
}
java_major=$("$java" -version 2>&1 | sed -n 's/^[a-z]* version "\(1\.\)\{0,1\}\([0-9]*\).*/\2/p' | head -1)
if [ -z "$java_major" ] || [ "$java_major" -lt 25 ]; then
  echo "$tool: needs JDK 25, and found ${java_major:-none} (see JAVA_HOME and the PATH), or run the Gradle task of it" >&2
  exit 1
fi

cd "$root"
exec "$java" "tools/$tool.java" "$@"
