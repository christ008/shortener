#!/bin/sh
# Starts a tool of tools/ from the root of the repository, building the tools first when a source is newer than the last build.
#
#   tools/run TOOL [ARGUMENTS...]       for example: tools/run Smoke http://localhost:8080
#
# Tools: Realms, DevSetup, Smoke, Report, Dataset. Needs Java 25 or newer (JAVA_HOME, else the PATH), and a JDK, not a JRE, to build.
# The first run builds them with Gradle (dependencies from Maven Central); later runs only start a JVM.
# Tests: ./gradlew -p tools test.
set -eu

tool=${1:?usage: tools/run TOOL [ARGUMENTS...]}
shift
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/.." && pwd)

java=java
[ -z "${JAVA_HOME:-}" ] || java=$JAVA_HOME/bin/java
command -v "$java" >/dev/null 2>&1 || {
  echo "$tool: needs a JDK 25 or newer, and found none (see JAVA_HOME and the PATH)" >&2
  exit 1
}
# Reads the version from the release file when there is one, without starting a JVM.
if [ -n "${JAVA_HOME:-}" ] && [ -r "$JAVA_HOME/release" ]; then
  java_major=$(sed -n 's/^JAVA_VERSION="\(1\.\)\{0,1\}\([0-9]*\).*/\2/p' "$JAVA_HOME/release" | head -1)
else
  java_major=$("$java" -version 2>&1 | sed -n 's/^[a-z]* version "\(1\.\)\{0,1\}\([0-9]*\).*/\2/p' | head -1)
fi
if [ -z "$java_major" ] || [ "$java_major" -lt 25 ]; then
  echo "$tool: needs a JDK 25 or newer, and found ${java_major:-none} (see JAVA_HOME and the PATH)" >&2
  exit 1
fi

cd "$root"
stamp=tools/build/.built
launcher=tools/build/install/tools/bin/tools
# Builds only when a source is newer than the last build.
if [ ! -x "$launcher" ] || [ ! -f "$stamp" ] ||
  [ -n "$(find tools/src/main tools/build.gradle.kts tools/settings.gradle.kts -newer "$stamp" -print -quit)" ]; then
  # Compiling for Java 25 reads lib/ct.sym, which a JRE does not have.
  java_home=${JAVA_HOME:-$("$java" -XshowSettings:properties -version 2>&1 | sed -n 's/^ *java\.home = //p' | head -1)}
  [ -r "$java_home/lib/ct.sym" ] || {
    echo "$tool: building the tools needs a JDK, and ${java_home:-the java on the PATH} is not one (it has no lib/ct.sym)" >&2
    exit 1
  }
  ./gradlew --console=plain -q -p tools installDist >&2 || {
    echo "$tool: the tools could not be built (see above)" >&2
    exit 1
  }
  touch "$stamp"
fi
exec "$launcher" "$tool" "$@"
