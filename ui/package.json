{
  "name": "shortener-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && node scripts/csp.mjs",
    "build:analyze": "vp build --mode analyze",
    "preview": "vp preview",
    "lint": "npm run oxlint && npm run stylelint",
    "oxlint": "vp lint",
    "stylelint": "stylelint '**/*.css' --cache",
    "format:test": "vp fmt --check",
    "format:write": "vp fmt",
    "vitest": "vp test run",
    "vitest:watch": "vp test watch",
    "test": "npm run check && npm run stylelint && npm run vitest && npm run build",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "gen:api": "npx -y openapi-typescript@7.13.0 ../docs/openapi.yaml -o src/api/schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mantine/core": "9.7.3",
    "@mantine/form": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@mantine/notifications": "9.7.3",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "oauth4webapi": "^3.8.8",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.0.0",
    "openapi-typescript": "^7.13.0",
    "oxc-config-mantine": "^1.0.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  },
  "packageManager": "yarn@4.18.1"
}
