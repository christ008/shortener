{
  "realm": "shortener",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "shortlinks:create",
      "description": "Create short links",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "shortener-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "shortener-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "shortlinks:claim",
      "description": "Choose a custom short code, in addition to create",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "shortener-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "shortener-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "shortlinks:read",
      "description": "List and read your own short links",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "shortener-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "shortener-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "shortlinks:delete",
      "description": "Disable your own short links",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "shortener-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "shortener-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "shortlinks:admin",
      "description": "Read and disable any client's short links, for abuse takedowns",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "shortener-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "shortener-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "demo-client",
      "name": "Demo client that manages its own links, including custom codes (dev only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "shortlinks:create",
        "shortlinks:claim",
        "shortlinks:read",
        "shortlinks:delete"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "token.endpoint.auth.signing.alg": "ES256",
        "use.jwks.string": "true",
        "jwks.string": "@JWKS:demo-client@",
        "dpop.bound.access.tokens": "true",
        "access.token.header.type.rfc9068": "true"
      },
      "protocolMappers": [
        {
          "name": "owner",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "owner",
            "claim.value": "demo-client",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "other-client",
      "name": "Second client without custom codes, to see ownership between clients (dev only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "shortlinks:create",
        "shortlinks:read",
        "shortlinks:delete"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "token.endpoint.auth.signing.alg": "ES256",
        "use.jwks.string": "true",
        "jwks.string": "@JWKS:other-client@",
        "dpop.bound.access.tokens": "true",
        "access.token.header.type.rfc9068": "true"
      },
      "protocolMappers": [
        {
          "name": "owner",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "owner",
            "claim.value": "other-client",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "admin-client",
      "name": "Administrator who can take down any link (dev only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "shortlinks:admin"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "token.endpoint.auth.signing.alg": "ES256",
        "use.jwks.string": "true",
        "jwks.string": "@JWKS:admin-client@",
        "dpop.bound.access.tokens": "true",
        "access.token.header.type.rfc9068": "true"
      },
      "protocolMappers": [
        {
          "name": "owner",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "owner",
            "claim.value": "admin-client",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "no-scope-client",
      "name": "Valid token but no scopes, to see a 403 (dev only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "shortener-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "shortener-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "owner",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "owner",
            "claim.value": "no-scope-client",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "token.endpoint.auth.signing.alg": "ES256",
        "use.jwks.string": "true",
        "jwks.string": "@JWKS:no-scope-client@",
        "dpop.bound.access.tokens": "true",
        "access.token.header.type.rfc9068": "true"
      }
    },
    {
      "clientId": "shortener-ui",
      "name": "The web UI, a public client that signs in users with code and PKCE and holds DPoP-bound tokens (dev only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/app/*",
        "http://localhost:5173/app/*",
        "http://localhost:8088/app/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173",
        "http://localhost:8088"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "dpop.bound.access.tokens": "true",
        "access.token.header.type.rfc9068": "true",
        "post.logout.redirect.uris": "http://localhost:3000/app/*##http://localhost:5173/app/*##http://localhost:8088/app/*"
      },
      "defaultClientScopes": [
        "shortlinks:create",
        "shortlinks:claim",
        "shortlinks:read",
        "shortlinks:delete"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "owner",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "id",
            "claim.name": "owner",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.test",
      "firstName": "Alice",
      "lastName": "Example",
      "credentials": [
        {
          "type": "password",
          "value": "@PASSWORD:alice@",
          "temporary": false
        }
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@example.test",
      "firstName": "Bob",
      "lastName": "Example",
      "credentials": [
        {
          "type": "password",
          "value": "@PASSWORD:bob@",
          "temporary": false
        }
      ]
    }
  ]
}
