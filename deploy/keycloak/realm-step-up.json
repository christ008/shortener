{
  "browserFlow": "browser-loa",
  "authenticationFlows": [
    {
      "alias": "browser-loa",
      "description": "The browser flow with levels of authentication: a password is level 1 and a password with a one-time code is level 2, asked for when a client requests acr_values=2. The acr claim of the token is the level, as a number",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "browser-loa forms",
          "userSetupAllowed": false,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "browser-loa forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "flowAlias": "browser-loa level 1",
          "userSetupAllowed": false,
          "authenticatorFlow": true
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "browser-loa level 2",
          "userSetupAllowed": false,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "browser-loa level 1",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "loa1",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "browser-loa level 2",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "loa2",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "loa1",
      "config": {
        "loa-condition-level": "1",
        "loa-store-in-user-session": "true",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "loa2",
      "config": {
        "loa-condition-level": "2",
        "loa-store-in-user-session": "true",
        "loa-max-age": "0"
      }
    }
  ]
}
