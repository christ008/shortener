#!/bin/sh
# Makes the cryptographic material and the passwords a local development setup needs, so none of it is committed. The work is
# the DevSetup tool (tools/), which says what it writes and how to use it: this only starts it.
#
#   deploy/keycloak/dev-setup [--yes] [--force] [--show]
set -eu
exec "$(dirname "$0")/../../tools/run" DevSetup "$@"
