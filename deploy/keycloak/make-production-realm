#!/bin/sh
# Makes the realm a production Keycloak imports, from shortener-realm.production.template.json and the public keys of its two
# clients. Nothing secret goes in: a public key is all the realm needs to trust a client.
#
#   java deploy/keycloak/DpopClient.java keygen demo-client  > demo.keys     # line 1 private, line 2 public
#   java deploy/keycloak/DpopClient.java keygen admin-client > admin.keys
#   sed -n 2p demo.keys  > demo-client.public.json
#   sed -n 2p admin.keys > admin-client.public.json
#   deploy/keycloak/make-production-realm demo-client.public.json admin-client.public.json
#
# It writes deploy/keycloak/shortener-realm.production.json, which Git ignores, or the file named by the third argument.
# Keep the private half of admin-client on your own machine: whoever holds it can take down any link. The private half of
# demo-client is published with the instance, so that visitors can try it.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
template=$here/shortener-realm.production.template.json
demo_public=${1:?usage: make-production-realm DEMO_PUBLIC_JWK_FILE ADMIN_PUBLIC_JWK_FILE [OUTPUT]}
admin_public=${2:?usage: make-production-realm DEMO_PUBLIC_JWK_FILE ADMIN_PUBLIC_JWK_FILE [OUTPUT]}
output=${3:-$here/shortener-realm.production.json}

for file in "$demo_public" "$admin_public"; do
  [ -r "$file" ] || { echo "make-production-realm: cannot read $file" >&2; exit 1; }
  if grep -q '"d"' "$file"; then
    echo "make-production-realm: $file holds a private key (it has a \"d\"); give the public half, line 2 of keygen's output" >&2
    exit 1
  fi
done

json_in_json() { sed 's/\\/\\\\/g; s/"/\\"/g'; }

replace() { # FILE PLACEHOLDER VALUE: a plain text replacement, with no regular expression and no escapes in the value
  PLACEHOLDER=$2 VALUE=$3 awk '{
    i = index($0, ENVIRON["PLACEHOLDER"])
    while (i) {
      $0 = substr($0, 1, i - 1) ENVIRON["VALUE"] substr($0, i + length(ENVIRON["PLACEHOLDER"]))
      i = index($0, ENVIRON["PLACEHOLDER"])
    }
    print }' "$1" >"$1.next"
  mv "$1.next" "$1"
}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM
cp "$template" "$work/realm.json"
replace "$work/realm.json" "@JWKS:demo-client@" "$(printf '{"keys":[%s]}' "$(cat "$demo_public")" | json_in_json)"
replace "$work/realm.json" "@JWKS:admin-client@" "$(printf '{"keys":[%s]}' "$(cat "$admin_public")" | json_in_json)"
if grep -q '@[A-Z]*:[a-z-]*@' "$work/realm.json"; then
  echo "make-production-realm: a placeholder was left in the realm" >&2
  exit 1
fi
cp "$work/realm.json" "$output"
chmod 644 "$output"
echo "wrote $output"
