#!/bin/sh
# A DPoP (RFC 9449) client for the local setup, in plain shell, openssl and curl. It authenticates to the identity
# provider with a signed assertion instead of a secret (private_key_jwt), gets an access token bound to a fresh key, and
# calls the API with a DPoP proof made for each request.
#
#   dpop keygen CLIENT_ID                      prints a private and a public JWK for a new client key
#   dpop call KEY_FILE CLIENT_ID METHOD URL [JSON_BODY]
#   dpop token KEY_FILE CLIENT_ID              prints a DPoP-bound access token
#   dpop login USER PASSWORD METHOD URL [JSON_BODY]
#                                              signs a user in the way a single-page app does (authorization code with
#                                              PKCE and a DPoP-bound code), shows the token's claims, refreshes it, then
#                                              calls the API as that user
#
# It runs on the machine of whoever calls the API, a laptop, a CI runner or an operator's host. It is not part of the
# service and is not deployed anywhere. It needs `openssl` (1.1.1 or LibreSSL 3 or newer), `curl`, and the usual `awk`,
# `sed`, `tr`, `od`, `head` and `tail`. Nothing else: no JDK.
#
# KEY_FILE is a private JWK, one line of JSON with the fields `x`, `y` and `d`, as `dev-setup` writes them.
#
# Settings, all optional:
#   TOKEN_URL     the token endpoint, by default the local realm
#   ISSUER        the issuer, by default TOKEN_URL without `/protocol/openid-connect/token`
#   TRACEPARENT   sent as the W3C trace context of a call, so a sampled trace can be forced
#   CURL_OPTS     extra options for curl, for example `--cacert cert.pem` for a certificate of your own
#   For login: CLIENT_ID (shortener-ui), REDIRECT_URI and SCOPE
# shellcheck disable=SC2086  # CURL_OPTS is a list of options, and is meant to be split
set -eu

TOKEN_URL=${TOKEN_URL:-http://localhost:8180/realms/shortener/protocol/openid-connect/token}
ISSUER=${ISSUER:-${TOKEN_URL%/protocol/openid-connect/token}}

usage() {
  cat >&2 <<'EOF'
usage: dpop keygen CLIENT_ID
       dpop token KEY_FILE CLIENT_ID
       dpop call KEY_FILE CLIENT_ID METHOD URL [JSON_BODY]
       dpop login USER PASSWORD METHOD URL [JSON_BODY]
EOF
  exit 2
}

die() {
  echo "dpop: $*" >&2
  exit 1
}

for tool in openssl curl awk sed tr od head tail date mktemp; do
  command -v "$tool" >/dev/null 2>&1 || die "needs $tool, which is not installed"
done

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM

# ---- encoding ---------------------------------------------------------------------------------------------------

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# base64url text to lowercase hex
b64url_to_hex() {
  printf '%s' "$1" | tr '_-' '/+' | awk '{ while (length($0) % 4) $0 = $0 "="; printf "%s", $0 }' |
    openssl base64 -d -A | od -An -v -tx1 | tr -d ' \n'
}

# base64url text to the text it encodes
b64url_to_text() {
  printf '%s' "$1" | tr '_-' '/+' | awk '{ while (length($0) % 4) $0 = $0 "="; printf "%s", $0 }' | openssl base64 -d -A
}

# hex on stdin to bytes on stdout, through printf's octal escapes, which POSIX has and a binary pipe needs
hex_to_bytes() {
  escapes=$(awk '{ s = tolower($0); for (i = 1; i < length(s); i += 2) {
    n = (index("0123456789abcdef", substr(s, i, 1)) - 1) * 16 + index("0123456789abcdef", substr(s, i + 1, 1)) - 1
    printf "\\0%03o", n } }')
  printf '%b' "$escapes"
}

json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

now() { date +%s; }

# ---- keys -------------------------------------------------------------------------------------------------------

# The value of a string field in a one-line JSON file or text.
json_field() { sed -n "s/.*\"$2\" *: *\"\\([^\"]*\\)\".*/\\1/p" "$1" | head -1; }
json_field_text() { printf '%s' "$1" | sed -n "s/.*\"$2\" *: *\"\\([^\"]*\\)\".*/\\1/p" | head -1; }

# Makes a PEM private key out of the d, x and y of a private JWK: the SEC1 structure of a P-256 key is fixed.
jwk_to_pem() {
  d=$(b64url_to_hex "$(json_field "$1" d)")
  x=$(b64url_to_hex "$(json_field "$1" x)")
  y=$(b64url_to_hex "$(json_field "$1" y)")
  [ "${#d}" -eq 64 ] && [ "${#x}" -eq 64 ] && [ "${#y}" -eq 64 ] || die "$1 is not a private P-256 JWK with x, y and d"
  printf '%s' "30770201010420${d}a00a06082a8648ce3d030107a14403420004${x}${y}" | hex_to_bytes >"$work/key.der"
  openssl ec -inform DER -in "$work/key.der" -out "$2" 2>/dev/null || die "could not read the key in $1"
}

new_key() { openssl ecparam -name prime256v1 -genkey -noout -out "$1" 2>/dev/null; }

# the x and y of the public half of a PEM key, as base64url, on two lines
pem_xy() {
  openssl ec -in "$1" -pubout -outform DER 2>/dev/null | tail -c 64 >"$work/xy.bin"
  head -c 32 "$work/xy.bin" | b64url
  echo
  tail -c 32 "$work/xy.bin" | b64url
  echo
}

pem_d() { openssl ec -in "$1" -outform DER 2>/dev/null | tail -c +8 | head -c 32 | b64url; }

# the RFC 7638 thumbprint of the public key
thumbprint() {
  xy=$(pem_xy "$1")
  x=$(printf '%s\n' "$xy" | sed -n 1p)
  y=$(printf '%s\n' "$xy" | sed -n 2p)
  printf '{"crv":"P-256","kty":"EC","x":"%s","y":"%s"}' "$x" "$y" | openssl dgst -sha256 -binary | b64url
}

# ---- signing ----------------------------------------------------------------------------------------------------

# ES256 is the raw r and s, 32 bytes each, where openssl signs in DER: read the two integers out of it.
sign_es256() {
  ints=$(printf '%s' "$2" | openssl dgst -sha256 -sign "$1" | openssl asn1parse -inform DER | sed -n 's/.*INTEGER *://p')
  [ "$(printf '%s\n' "$ints" | wc -l)" -eq 2 ] || die "could not sign"
  printf '%s\n' "$ints" | awk '{ h = tolower($0); while (length(h) > 64) h = substr(h, 3); while (length(h) < 64) h = "0" h; printf "%s", h }' |
    hex_to_bytes | b64url
}

# jwt KEY HEADER_JSON CLAIMS_JSON
jwt() {
  input="$(printf '%s' "$2" | b64url).$(printf '%s' "$3" | b64url)"
  printf '%s.%s' "$input" "$(sign_es256 "$1" "$input")"
}

# proof PEM METHOD URL [ACCESS_TOKEN]: the DPoP proof for one request
proof() {
  xy=$(pem_xy "$1")
  x=$(printf '%s\n' "$xy" | sed -n 1p)
  y=$(printf '%s\n' "$xy" | sed -n 2p)
  htu=$(printf '%s' "$3" | sed 's/[?#].*//')
  ath=''
  if [ -n "${4:-}" ]; then ath=",\"ath\":\"$(printf '%s' "$4" | openssl dgst -sha256 -binary | b64url)\""; fi
  jwt "$1" \
    "{\"alg\":\"ES256\",\"typ\":\"dpop+jwt\",\"jwk\":{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"$x\",\"y\":\"$y\"}}" \
    "{\"jti\":\"$(openssl rand -hex 16)\",\"htm\":\"$2\",\"htu\":\"$(json_escape "$htu")\",\"iat\":$(now)$ath}"
}

# ---- the identity provider --------------------------------------------------------------------------------------

# token_request DPOP_PEM NAME=VALUE...: posts a form to the token endpoint with a DPoP proof, and prints the answer.
# Fails, printing what the endpoint said, for anything but a 200.
token_request() {
  pem=$1
  shift
  dpop=$(proof "$pem" POST "$TOKEN_URL")
  count=$#
  while [ "$count" -gt 0 ]; do
    pair=$1
    shift
    set -- "$@" --data-urlencode "$pair"
    count=$((count - 1))
  done
  # shellcheck disable=SC2086
  code=$(curl -s -S --max-time 30 ${CURL_OPTS:-} -o "$work/token.json" -w '%{http_code}' -H "DPoP: $dpop" "$@" "$TOKEN_URL" 2>"$work/curl.err") || true
  if [ "$code" != 200 ]; then
    echo "token endpoint answered $code: $(cat "$work/token.json" 2>/dev/null)$(cat "$work/curl.err")" >&2
    return 1
  fi
  cat "$work/token.json"
}

client_token() { # KEY_FILE CLIENT_ID DPOP_PEM
  jwk_to_pem "$1" "$work/client.pem"
  assertion=$(jwt "$work/client.pem" '{"alg":"ES256"}' \
    "{\"iss\":\"$2\",\"sub\":\"$2\",\"aud\":\"$ISSUER\",\"jti\":\"$(openssl rand -hex 16)\",\"iat\":$(now),\"exp\":$(($(now) + 60))}")
  body=$(token_request "$3" grant_type=client_credentials "client_id=$2" \
    client_assertion_type=urn:ietf:params:oauth:client-assertion-type:jwt-bearer "client_assertion=$assertion") || exit 1
  token=$(json_field_text "$body" access_token)
  [ -n "$token" ] || die "no access_token in $body"
  printf '%s' "$token"
}

# ---- commands ---------------------------------------------------------------------------------------------------

cmd_keygen() {
  new_key "$work/k.pem"
  xy=$(pem_xy "$work/k.pem")
  x=$(printf '%s\n' "$xy" | sed -n 1p)
  y=$(printf '%s\n' "$xy" | sed -n 2p)
  d=$(pem_d "$work/k.pem")
  printf '{"kty":"EC","crv":"P-256","kid":"%s-key-1","alg":"ES256","use":"sig","x":"%s","y":"%s","d":"%s"}\n' "$1" "$x" "$y" "$d"
  printf '{"kty":"EC","crv":"P-256","kid":"%s-key-1","alg":"ES256","use":"sig","x":"%s","y":"%s"}\n' "$1" "$x" "$y"
}

cmd_token() {
  new_key "$work/dpop.pem"
  client_token "$1" "$2" "$work/dpop.pem"
  echo
}

cmd_call() {
  new_key "$work/dpop.pem"
  token=$(client_token "$1" "$2" "$work/dpop.pem")
  method=$3
  url=$4
  body=${5:-}
  set -- -H "Authorization: DPoP $token" -H "DPoP: $(proof "$work/dpop.pem" "$method" "$url" "$token")"
  [ -z "$body" ] || set -- "$@" -H 'Content-Type: application/json' --data-binary "$body"
  [ -z "${TRACEPARENT:-}" ] || set -- "$@" -H "traceparent: $TRACEPARENT"
  code=$(curl -s -S --max-time 30 ${CURL_OPTS:-} -X "$method" -D "$work/headers" -o "$work/body" -w '%{http_code}' "$@" "$url") ||
    die "could not call $url"
  echo "$code"
  sed -n 's/^[Ll]ocation: *\(.*\)$/Location: \1/p' "$work/headers" | tr -d '\r'
  sed -n 's/^[Ww][Ww][Ww]-[Aa]uthenticate: *\(.*\)$/WWW-Authenticate: \1/p' "$work/headers" | tr -d '\r'
  cat "$work/body"
  echo
}

cmd_login() {
  user=$1
  password=$2
  method=$3
  url=$4
  body=${5:-}
  client=${CLIENT_ID:-shortener-ui}
  redirect=${REDIRECT_URI:-http://localhost:3000/app/auth/callback}
  scope=${SCOPE:-shortlinks:create shortlinks:claim shortlinks:read shortlinks:delete}

  new_key "$work/dpop.pem"
  jkt=$(thumbprint "$work/dpop.pem")
  verifier=$(openssl rand 32 | b64url)
  challenge=$(printf '%s' "$verifier" | openssl dgst -sha256 -binary | b64url)
  state=$(openssl rand -hex 16)

  jar="$work/cookies"
  curl -s -S --max-time 30 ${CURL_OPTS:-} -c "$jar" -b "$jar" -G -o "$work/page.html" \
    --data-urlencode response_type=code --data-urlencode "client_id=$client" --data-urlencode "redirect_uri=$redirect" \
    --data-urlencode "scope=$scope" --data-urlencode "state=$state" --data-urlencode "code_challenge=$challenge" \
    --data-urlencode code_challenge_method=S256 --data-urlencode "dpop_jkt=$jkt" \
    "$ISSUER/protocol/openid-connect/auth" || die "could not reach $ISSUER"
  action=$(tr '\n' ' ' <"$work/page.html" | sed -n 's/.*<form[^>]*id="kc-form-login"[^>]*action="\([^"]*\)".*/\1/p' | sed 's/&amp;/\&/g')
  [ -n "$action" ] || die "no login form: $(tr '\n' ' ' <"$work/page.html" | cut -c1-300)"

  curl -s -S --max-time 30 ${CURL_OPTS:-} -c "$jar" -b "$jar" -D "$work/login.headers" -o /dev/null \
    --data-urlencode "username=$user" --data-urlencode "password=$password" --data-urlencode credentialId= "$action" ||
    die "could not submit the login"
  location=$(sed -n 's/^[Ll]ocation: *\(.*\)$/\1/p' "$work/login.headers" | tr -d '\r' | head -1)
  [ -n "$location" ] || die "the login did not redirect"
  code=$(printf '%s' "$location" | sed -n 's/.*[?&]code=\([^&]*\).*/\1/p')
  returned_state=$(printf '%s' "$location" | sed -n 's/.*[?&]state=\([^&#]*\).*/\1/p')
  [ "$returned_state" = "$state" ] || die "state mismatch"
  echo "1. signed in as $user; redirected to ${location%%\?*} with a code"

  tokens=$(token_request "$work/dpop.pem" grant_type=authorization_code "client_id=$client" "code=$code" \
    "redirect_uri=$redirect" "code_verifier=$verifier") || exit 1
  access=$(json_field_text "$tokens" access_token)
  refresh=$(json_field_text "$tokens" refresh_token)
  issued=NOT\ issued
  [ -z "$refresh" ] || issued=issued
  echo "2. token_type $(json_field_text "$tokens" token_type), refresh token $issued"
  claims=$(b64url_to_text "$(printf '%s' "$access" | cut -d. -f2)")
  echo "3. access token header $(b64url_to_text "$(printf '%s' "$access" | cut -d. -f1)")"
  echo "   claims $claims"
  bound=$(printf '%s' "$claims" | sed -n 's/.*"jkt" *: *"\([^"]*\)".*/\1/p')
  if [ "$bound" = "$jkt" ]; then echo "   bound to this client's key: true"; else echo "   bound to this client's key: false"; fi

  refreshed=$(token_request "$work/dpop.pem" grant_type=refresh_token "client_id=$client" "refresh_token=$refresh") || exit 1
  new_access=$(json_field_text "$refreshed" access_token)
  new_refresh=$(json_field_text "$refreshed" refresh_token)
  new_claims=$(b64url_to_text "$(printf '%s' "$new_access" | cut -d. -f2)")
  case "$new_claims" in *"$jkt"*) still=true ;; *) still=false ;; esac
  if [ "$refresh" != "$new_refresh" ]; then rotated=true; else rotated=false; fi
  echo "4. refreshed with the same key; new token bound to it: $still, refresh token rotated: $rotated"
  if token_request "$work/dpop.pem" grant_type=refresh_token "client_id=$client" "refresh_token=$refresh" >/dev/null 2>&1; then
    echo "   reusing the old refresh token: ACCEPTED (rotation is not enforced)"
  else
    echo "   reusing the old refresh token: refused, as rotation requires"
  fi
  new_key "$work/other.pem"
  if token_request "$work/other.pem" grant_type=refresh_token "client_id=$client" "refresh_token=$new_refresh" >/dev/null 2>&1; then
    echo "   refreshing with a different key: ACCEPTED (the refresh token is not bound to the key)"
  else
    echo "   refreshing with a different key: refused"
  fi

  set -- -H "Authorization: DPoP $new_access" -H "DPoP: $(proof "$work/dpop.pem" "$method" "$url" "$new_access")" -H 'Content-Type: application/json'
  [ -z "$body" ] || set -- "$@" --data-binary "$body"
  status=$(curl -s -S --max-time 30 ${CURL_OPTS:-} -X "$method" -D "$work/headers" -o "$work/body" -w '%{http_code}' "$@" "$url") ||
    die "could not call $url"
  echo "5. $method $url -> $status"
  sed -n 's/^[Ww][Ww][Ww]-[Aa]uthenticate: *\(.*\)$/   WWW-Authenticate: \1/p' "$work/headers" | tr -d '\r'
  echo "   $(cat "$work/body")"
}

# The tests load the functions of this file and call them, with DPOP_AS_LIBRARY set.
[ -z "${DPOP_AS_LIBRARY:-}" ] || return 0

[ $# -gt 0 ] || usage
case "$1" in
  keygen) [ $# -eq 2 ] || usage; cmd_keygen "$2" ;;
  token) [ $# -eq 3 ] || usage; cmd_token "$2" "$3" ;;
  call) { [ $# -eq 5 ] || [ $# -eq 6 ]; } || usage; shift; cmd_call "$@" ;;
  login) { [ $# -eq 5 ] || [ $# -eq 6 ]; } || usage; shift; cmd_login "$@" ;;
  *) usage ;;
esac
