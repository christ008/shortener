        "jwks.string": "{\"keys\":[{\"kty\":\"EC\",\"crv\":\"P-256\",\"kid\":\"other-client-key-1\",\"alg\":\"ES256\",\"use\":\"sig\",\"x\":\"MrQtnRcdKyysEjQxzgff11BwgCQo4w9kJ1nAn5mrIcE\",\"y\":\"dec5ZiLjSWjEuf04F65F2yvK-mxY0yQ4EoDwcCVulJ0\"}]}",
        "dpop.bound.access.tokens": "true",
        "access.token.header.type.rfc9068": "true"
      }
    },
    {
      "clientId": "admin-client",
      "name": "Administrator who can take down any link (dev only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "shortlinks:admin"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "token.endpoint.auth.signing.alg": "ES256",
        "use.jwks.string": "true",
        "jwks.string": "{\"keys\":[{\"kty\":\"EC\",\"crv\":\"P-256\",\"kid\":\"admin-client-key-1\",\"alg\":\"ES256\",\"use\":\"sig\",\"x\":\"q81zszivr-_6C1oHXwRr0VaGQe7ypmBmO5OLjtjlOCY\",\"y\":\"0ckqiOQJKPN9RPI1rgNtPvW3aPpw_kqFGIP6pxAHaIc\"}]}",
