            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "token.endpoint.auth.signing.alg": "ES256",
        "use.jwks.string": "true",
        "jwks.string": "{\"keys\":[{\"kty\":\"EC\",\"crv\":\"P-256\",\"kid\":\"no-scope-client-key-1\",\"alg\":\"ES256\",\"use\":\"sig\",\"x\":\"IMT-2XRIvTP1YRubfHx_aCVpeEFwW9VkbJDCXxUqcFg\",\"y\":\"NTJW816ca7c5jy0bx6_W67wPFBTH3aylhR-8k2yM-bw\"}]}",
