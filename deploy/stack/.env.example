# Variables of compose.prod.yaml. Copy to .env next to it (Git ignores it) and fill in.

# The application image. Releases are published to GitHub Container Registry by the Release workflow.
SHORTENER_IMAGE=ghcr.io/christ008/shortener
SHORTENER_VERSION=0.21.0
# The version the migration job runs. The same as SHORTENER_VERSION, except while updating: deploy/stack/deploy.sh sets
# it, and runs the job before it updates the application.
SHORTENER_MIGRATE_VERSION=0.21.0

# The identity provider: the issuer its tokens carry, and where it publishes its keys.
ISSUER_URI=https://auth.example.com/realms/shortener
JWKS_URI=https://auth.example.com/realms/shortener/protocol/openid-connect/certs

# Which hosts links may point to. Set one of the two, or the application does not start.
# A list, comma separated: example.com for one host, *.example.org for its subdomains. A public instance must use this.
#ALLOWED_TARGET_HOSTS=example.com,*.example.org
# Or accept every host, which is what a private instance of trusted clients may want. Never on a public one.
#ALLOW_ANY_TARGET=true

# Optional.
# With compose.prod.keycloak.yaml, the stack's own identity provider (docs/DEPLOY.md#keycloak):
#   PUBLIC_URL=https://shortener.example.com
#   ISSUER_URI=https://shortener.example.com/realms/shortener
#   JWKS_URI=http://keycloak:8080/realms/shortener/protocol/openid-connect/certs
#   KEYCLOAK_IMAGE=shortener-keycloak
#   KEYCLOAK_VERSION=26.7.5
# With compose.prod.postgres-ha.yaml (docs/DEPLOY.md#backups-and-a-replica): the image built from deploy/postgres.
#POSTGRES_IMAGE=shortener-postgres
#POSTGRES_VERSION=18.6
# Where traces go (OTLP over HTTP). Sampling is 5% under the production profile.
#OTLP_ENDPOINT=http://collector.example.com:4318/v1/traces
# A managed database instead of the postgres service: the application connects as shortener_app, the migration job as
# shortener_migrator (create the roles with deploy/postgres/bootstrap.sql, passwords as secrets).
#SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.com:5432/shortener?sslmode=verify-full
#SPRING_FLYWAY_URL=jdbc:postgresql://db.example.com:5432/shortener?sslmode=verify-full
# Where the secret files are, default ./secrets.
#SECRETS_DIR=/etc/shortener/secrets
