# Variables of compose.prod.yaml. Copy to .env (Git ignores it) and fill in.

# Application image (published by the Release workflow).
SHORTENER_IMAGE=ghcr.io/christ008/shortener
SHORTENER_VERSION=0.21.0
# Version of the migration job. Equal to SHORTENER_VERSION except during an update (deploy/stack/deploy.sh sets it).
SHORTENER_MIGRATE_VERSION=0.21.0

# Identity provider: token issuer and key endpoint.
ISSUER_URI=https://auth.example.com/realms/shortener
JWKS_URI=https://auth.example.com/realms/shortener/protocol/openid-connect/certs

# Hosts links may point to. Set one of the two, or the application does not start.
# A comma-separated list: example.com for one host, *.example.org for its subdomains. Required on a public instance.
#ALLOWED_TARGET_HOSTS=example.com,*.example.org
# Or accept every host: private instances of trusted clients only.
#ALLOW_ANY_TARGET=true

# Optional.
# The stack's own Keycloak, with compose.prod.keycloak.yaml (docs/DEPLOY.md#keycloak):
#   PUBLIC_URL=https://shortener.example.com
#   ISSUER_URI=https://shortener.example.com/realms/shortener
#   JWKS_URI=http://keycloak:8080/realms/shortener/protocol/openid-connect/certs
#   KEYCLOAK_IMAGE=shortener-keycloak
#   KEYCLOAK_VERSION=26.7.5
# Trace export (OTLP over HTTP). Sampling is 5% under the production profile.
#OTLP_ENDPOINT=http://collector.example.com:4318/v1/traces
# A managed database instead of the postgres service. Roles: deploy/postgres/bootstrap.sql, passwords as secrets.
#SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.com:5432/shortener?sslmode=verify-full
#SPRING_FLYWAY_URL=jdbc:postgresql://db.example.com:5432/shortener?sslmode=verify-full
# Directory of the secret files, default ./secrets.
#SECRETS_DIR=/etc/shortener/secrets
